 //
@@ -32,8 +33,8 @@ void HighlightRule::addElem(const std::string &name) {
 }
 
 bool HighlightRule::tryToMatch(const std::string &s, HighlightToken &token,
-        const MatchingParameters &params) {
-    return tryToMatch(s.begin(), s.end(), token, params);
+        const MatchingParameters &params, bool anchored) {
+    return tryToMatch(s.begin(), s.end(), token, params, anchored);
 }
 
 }

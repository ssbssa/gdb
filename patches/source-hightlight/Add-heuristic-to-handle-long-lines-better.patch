 lib/srchilite/highlightrule.h        |  5 +-
 lib/srchilite/highlightstate.cpp     | 75 +++++++++++++++++++++-------
 lib/srchilite/regexhighlightrule.cpp | 22 +++++---
 lib/srchilite/regexhighlightrule.h   |  4 +-

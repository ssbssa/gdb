@@ -34,7 +34,7 @@ RegexHighlightRule::~RegexHighlightRule() {
 
 bool RegexHighlightRule::tryToMatch(std::string::const_iterator start,
         std::string::const_iterator end, HighlightToken &token,
-        const MatchingParameters &params) {
+        const MatchingParameters &params, bool anchored) {
     boost::smatch match;
     boost::match_flag_type flags = boost::match_default;
 
@@ -46,7 +46,13 @@ bool RegexHighlightRule::tryToMatch(std::string::const_iterator start,
         flags |= boost::match_not_bol;
     }
 
-    if (boost::regex_search(start, end, match, regExp, flags)) {
+    bool found = boost::regex_search(start, end, match, anchored ? anchoredRegExp : regExp, flags);
+    if (found && anchored) {
+        // Search again using the unanchored regexp to get the prefix right.
+        found = boost::regex_search(start, end, match, regExp, flags);
+    }
+
+    if (found) {
         token.prefix = match.prefix();
         token.suffix = match.suffix();
 
@@ -82,6 +88,7 @@ const std::string RegexHighlightRule::toString() const {
 
 void RegexHighlightRule::replaceReferences(const ReplacementList &rep) {
     regExp.assign(RegexPreProcessor::replace_references(regExp.str(), rep));
+    anchoredRegExp.assign(RegexPreProcessor::replace_references(anchoredRegExp.str(), rep));
 }
 
 HighlightRule *RegexHighlightRule::clone() {
@@ -90,6 +97,7 @@ HighlightRule *RegexHighlightRule::clone() {
 
 void RegexHighlightRule::setRegExp(const std::string &s) {
     regExp.assign(s);
+    anchoredRegExp.assign ("\\A[[:blank:]]*" + s);
 }
 
 }

diff --git a/lib/srchilite/highlightstate.cpp b/lib/srchilite/highlightstate.cpp
index ec9148f..c86d52e 100644
--- a/lib/srchilite/highlightstate.cpp
+++ b/lib/srchilite/highlightstate.cpp
@@ -1,3 +1,4 @@
+// -*- tab-width:4 indent-tabs-mode:nil c-basic-offset:4 -*-
 //
 // Author: Lorenzo Bettini <http://www.lorenzobettini.it>, (C) 2004-2008
 //
@@ -53,27 +54,65 @@ bool HighlightState::findBestMatch(std::string::const_iterator start,
     const HighlightRule *bestMatchingRule = 0;
     HighlightRule *currentRule = 0;
     bool first = true;
-
-    for (RuleList::const_iterator it = ruleList.begin(); it != ruleList.end(); ++it) {
-        currentRule = (*it).get();
-        tempToken.clearMatched();
-
-        if (currentRule->tryToMatch(start, end, tempToken, params)) {
-            if (first || betterThan(tempToken, bestToken)) {
-                // the first one, it's always the best
-                if (first) {
-                    first = false;
-                }
-                bestToken.copyFrom(tempToken);
-                bestMatchingRule = currentRule;
-
-                // if we matched something with no prefix (or only spaces)...
-                if (tempToken.prefixOnlySpaces) {
-                    // ...don't try any other rule
-                    break;
+    bool foundBestPossible = false;
+
+    // The strategy used by source-highlight is to select the first matching
+    // rule:
+    // - with empty prefix (or prefix containing only space characters, i.e.,
+    //   spaces or tabs), or
+    // - with the smallest prefix.
+    //
+    // The simplest implementation of this is to try rules in order, keeping
+    // track of the best-match-sofar, and stopping iteration once the
+    // best-match-possible is reached.
+    //
+    // The regexps of the rules can be unanchored though, and for long lines
+    // this can become very slow.
+    //
+    // So, we use a heuristic to avoid unanchored search, if we can, by
+    // searching in two phases:
+    // - anchored == true: we force an anchored search by prefixing the regexp
+    //   with "\\A[[:blank:]]*".  The "\\A" matches the start of the buffer, the
+    //   "[[:blank:]]" matches the spaces or tabs part.  If a match is found
+    //   with no prefix, then then the next phase can be skipped.
+    // - anchored == false: we search with the unmodified regexp, which may or
+    //   may not be anchored.
+
+    for (bool anchored : { true, false }) {
+        for (RuleList::const_iterator it = ruleList.begin(); it != ruleList.end(); ++it) {
+            currentRule = (*it).get();
+            tempToken.clearMatched();
+
+            if (currentRule->tryToMatch(start, end, tempToken, params, anchored)) {
+                if (first || betterThan(tempToken, bestToken)) {
+                    // the first one, it's always the best
+                    if (first) {
+                        first = false;
+                    }
+                    bestToken.copyFrom(tempToken);
+                    bestMatchingRule = currentRule;
+
+                    // if we matched something with no prefix (or only spaces)...
+                    if (tempToken.prefixOnlySpaces) {
+                        // ...don't try any other rule
+                        foundBestPossible = true;
+                        break;
+                    }
                 }
             }
         }
+
+        if (anchored && foundBestPossible) {
+            // We found the best possible match using the anchored regexp, so
+            // we're done, no need to try the unanchored case.
+            break;
+        }
+
+        if (anchored) {
+            // We reset the bestToken sofar, to make sure the the order
+            // between rules is respected.
+            first = true;
+        }
     }
 
     if (!first) {

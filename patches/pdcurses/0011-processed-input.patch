From 2eff5fe592c1712ff7c00d7a4c46f2187ee7c1cc Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Sat, 23 Feb 2019 14:01:04 +0100
Subject: [PATCH 11/14] processed input

---
 win32/pdckbd.c  | 6 ++++--
 win32/pdcscrn.c | 5 +++++
 win32/pdcwin.h  | 1 +
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/win32/pdckbd.c b/win32/pdckbd.c
index 4ad64268..38403593 100644
--- a/win32/pdckbd.c
+++ b/win32/pdckbd.c
@@ -642,8 +642,10 @@ int PDC_mouse_set(void)
        If turning off the mouse: Set QuickEdit Mode to the status it 
        had on startup, and clear all other flags */
 
-    SetConsoleMode(pdc_con_in, SP->_trap_mbe ?
-                   (ENABLE_MOUSE_INPUT|0x0080) : (pdc_quick_edit|0x0080));
+    DWORD mode = SP->_trap_mbe ?
+      (ENABLE_MOUSE_INPUT|0x0080) : (pdc_quick_edit|0x0080);
+
+    SetConsoleMode(pdc_con_in, pdc_processed_input | mode);
 
     memset(&old_mouse_status, 0, sizeof(old_mouse_status));
 
diff --git a/win32/pdcscrn.c b/win32/pdcscrn.c
index 6dd8f9d1..1135d41b 100644
--- a/win32/pdcscrn.c
+++ b/win32/pdcscrn.c
@@ -18,6 +18,7 @@ HANDLE pdc_con_out = INVALID_HANDLE_VALUE;
 HANDLE pdc_con_in = INVALID_HANDLE_VALUE;
 
 DWORD pdc_quick_edit;
+DWORD pdc_processed_input;
 
 static short curstoreal[16], realtocurs[16] =
 {
@@ -315,6 +316,10 @@ int PDC_scr_open(int argc, char **argv)
 
     pdc_quick_edit = old_console_mode & 0x0040;
 
+    /* preserve processed input setting (ctrl-c handling) */
+
+    pdc_processed_input = old_console_mode & ENABLE_PROCESSED_INPUT;
+
     SP->lines = PDC_get_rows();
     SP->cols = PDC_get_columns();
 
diff --git a/win32/pdcwin.h b/win32/pdcwin.h
index bb3396f0..4db95f6d 100644
--- a/win32/pdcwin.h
+++ b/win32/pdcwin.h
@@ -13,5 +13,6 @@
 extern unsigned char *pdc_atrtab;
 extern HANDLE pdc_con_out, pdc_con_in;
 extern DWORD pdc_quick_edit;
+extern DWORD pdc_processed_input;
 
 extern int PDC_get_buffer_rows(void);
-- 

From 815aa344a28cc70b8a7d9c59a6a243d63929a4c4 Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Fri, 9 Jan 2015 17:13:27 +0100
Subject: [PATCH 14/23] Don't highlight wrong execution point

---
 gdb/tui/tui-data.c   | 1 +
 gdb/tui/tui-data.h   | 1 +
 gdb/tui/tui-source.c | 2 +-
 gdb/tui/tui-stack.c  | 2 ++
 4 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/gdb/tui/tui-data.c b/gdb/tui/tui-data.c
index e5f2f5ba65..0bde74d014 100644
--- a/gdb/tui/tui-data.c
+++ b/gdb/tui/tui-data.c
@@ -505,6 +505,7 @@ init_content_element (struct tui_win_element *element,
       element->which_element.locator.full_name[0] =
 	element->which_element.locator.proc_name[0] = (char) 0;
       element->which_element.locator.line_no = 0;
+      element->which_element.locator.line_file_name[0] = (char) 0;
       element->which_element.locator.addr = 0;
       break;
     case EXEC_INFO_WIN:
diff --git a/gdb/tui/tui-data.h b/gdb/tui/tui-data.h
index 791aa4f1f7..72e0fe639a 100644
--- a/gdb/tui/tui-data.h
+++ b/gdb/tui/tui-data.h
@@ -196,6 +196,7 @@ struct tui_locator_element
   char full_name[MAX_LOCATOR_ELEMENT_LEN];
   char proc_name[MAX_LOCATOR_ELEMENT_LEN];
   int line_no;
+  char line_file_name[MAX_LOCATOR_ELEMENT_LEN];
   CORE_ADDR addr;
   /* Architecture associated with code at this location.  */
   struct gdbarch *gdbarch;
diff --git a/gdb/tui/tui-source.c b/gdb/tui/tui-source.c
index bade77cf80..76c75bec72 100644
--- a/gdb/tui/tui-source.c
+++ b/gdb/tui/tui-source.c
@@ -721,7 +721,7 @@ tui_set_source_content (struct symtab *s,
 			cur_line_no;
 		      element->which_element.source.is_exec_point =
 			(filename_cmp (locator->content[0]
-				         ->which_element.locator.full_name,
+				         ->which_element.locator.line_file_name,
 				       symtab_to_fullname (s)) == 0
 				         && cur_line_no
 					      == locator->content[0]
diff --git a/gdb/tui/tui-stack.c b/gdb/tui/tui-stack.c
index 3667e40208..6af674eb8b 100644
--- a/gdb/tui/tui-stack.c
+++ b/gdb/tui/tui-stack.c
@@ -332,6 +332,8 @@ tui_set_locator_info (struct gdbarch *gdbarch,
   element->proc_name[0] = (char) 0;
   strcat_to_buf (element->proc_name, MAX_LOCATOR_ELEMENT_LEN, procname);
   element->line_no = lineno;
+  element->line_file_name[0] = 0;
+  strcat_to_buf (element->line_file_name, MAX_LOCATOR_ELEMENT_LEN, fullname);
   element->addr = addr;
   element->gdbarch = gdbarch;
   tui_set_locator_fullname (fullname);
-- 
2.15.1.windows.2


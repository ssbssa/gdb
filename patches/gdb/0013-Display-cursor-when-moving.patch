From cb32751b58f695839396573781a7f40248805dde Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Mon, 12 Jan 2015 17:51:13 +0100
Subject: [PATCH 13/23] Display cursor when moving

---
 readline/display.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/readline/display.c b/readline/display.c
index 9044305797..5a4695f8fb 100644
--- a/readline/display.c
+++ b/readline/display.c
@@ -45,6 +45,10 @@
 # include <pc.h>
 #endif
 
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
 /* System-specific feature definitions and include files. */
 #include "rldefs.h"
 #include "rlmbutil.h"
@@ -1251,6 +1255,19 @@ rl_redisplay ()
 
   RL_UNSETSTATE (RL_STATE_REDISPLAYING);
   _rl_release_sigint ();
+
+#ifdef _WIN32
+    {
+      HANDLE out;
+      CONSOLE_SCREEN_BUFFER_INFO csbi;
+
+      out = GetStdHandle (STD_OUTPUT_HANDLE);
+      GetConsoleScreenBufferInfo(out, &csbi);
+      if (csbi.dwCursorPosition.Y >= csbi.srWindow.Top &&
+	  csbi.dwCursorPosition.Y <= csbi.srWindow.Bottom)
+	SetConsoleCursorPosition(out, csbi.dwCursorPosition);
+    }
+#endif
 }
 

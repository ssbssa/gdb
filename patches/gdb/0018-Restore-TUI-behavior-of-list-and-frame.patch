From 5c17bb3b2f622c14315a24a472813c41b8b30912 Mon Sep 17 00:00:00 2001
From: Hannes Domani <ssbssa@yahoo.de>
Date: Fri, 4 Sep 2015 15:55:24 +0200
Subject: [PATCH 18/23] Restore TUI behavior of "list" and "frame"

---
 gdb/stack.c         | 20 ++++++++++++++++++++
 gdb/thread.c        |  8 ++++++++
 gdb/tui/tui-hooks.c |  9 ++++++++-
 gdb/tui/tui-stack.c |  5 +----
 gdb/tui/tui-stack.h |  1 +
 5 files changed, 38 insertions(+), 5 deletions(-)

diff --git a/gdb/stack.c b/gdb/stack.c
index 9993ae654a..f4511ea2ed 100644
--- a/gdb/stack.c
+++ b/gdb/stack.c
@@ -2259,6 +2259,10 @@ find_relative_frame (struct frame_info *frame, int *level_offset_ptr)
   return frame;
 }
 
+#ifdef TUI
+extern int tui_new_selected_frame;
+#endif
+
 /* The "select_frame" command.  With no argument this is a NOP.
    Select the frame at level LEVEL_EXP if it is a valid level.
    Otherwise, treat LEVEL_EXP as an address expression and select it.
@@ -2274,6 +2278,10 @@ select_frame_command (const char *level_exp, int from_tty)
   select_frame (parse_frame_specification (level_exp, NULL));
   if (get_selected_frame_if_set () != prev_frame)
     observer_notify_user_selected_context_changed (USER_SELECTED_FRAME);
+
+#ifdef TUI
+  tui_new_selected_frame = 1;
+#endif
 }
 
 /* The "frame" command.  With no argument, print the selected frame
@@ -2290,6 +2298,10 @@ frame_command (const char *level_exp, int from_tty)
     observer_notify_user_selected_context_changed (USER_SELECTED_FRAME);
   else
     print_selected_thread_frame (current_uiout, USER_SELECTED_FRAME);
+
+#ifdef TUI
+  tui_new_selected_frame = 1;
+#endif
 }
 
 /* Select the frame up one or COUNT_EXP stack levels from the
@@ -2308,6 +2320,10 @@ up_silently_base (const char *count_exp)
   if (count != 0 && count_exp == NULL)
     error (_("Initial frame selected; you cannot go up."));
   select_frame (frame);
+
+#ifdef TUI
+  tui_new_selected_frame = 1;
+#endif
 }
 
 static void
@@ -2347,6 +2363,10 @@ down_silently_base (const char *count_exp)
     }
 
   select_frame (frame);
+
+#ifdef TUI
+  tui_new_selected_frame = 1;
+#endif
 }
 
 static void
diff --git a/gdb/thread.c b/gdb/thread.c
index 36cfcdd632..a0b4305eb7 100644
--- a/gdb/thread.c
+++ b/gdb/thread.c
@@ -1788,6 +1788,10 @@ thread_apply_command (const char *tidlist, int from_tty)
     }
 }
 
+#ifdef TUI
+extern int tui_new_selected_frame;
+#endif
+
 /* Switch to the specified thread.  Will dispatch off to thread_apply_command
    if prefix of arg is `apply'.  */
 
@@ -1834,6 +1838,10 @@ thread_command (const char *tidstr, int from_tty)
 	  observer_notify_user_selected_context_changed (USER_SELECTED_THREAD
 							 | USER_SELECTED_FRAME);
 	}
+
+#ifdef TUI
+      tui_new_selected_frame = 1;
+#endif
     }
 }
 
diff --git a/gdb/tui/tui-hooks.c b/gdb/tui/tui-hooks.c
index 84e416e756..81f3f1c692 100644
--- a/gdb/tui/tui-hooks.c
+++ b/gdb/tui/tui-hooks.c
@@ -182,6 +182,8 @@ tui_inferior_exit (struct inferior *inf)
 
 /* Observer for the before_prompt notification.  */
 
+int tui_new_selected_frame;
+
 static void
 tui_before_prompt (const char *current_gdb_prompt)
 {
@@ -190,7 +192,12 @@ tui_before_prompt (const char *current_gdb_prompt)
      refresh registers here unless the frame actually changed by one of these
      commands.  Registers will otherwise be refreshed after a normal stop or by
      our tui_register_changed_hook.  */
-  tui_refresh_frame_and_register_information (/*registers_too_p=*/0);
+  if (tui_new_selected_frame)
+    {
+      tui_set_locator_fullname ("");
+      tui_refresh_frame_and_register_information (/*registers_too_p=*/0);
+      tui_new_selected_frame = 0;
+    }
 }
 
 /* Observer for the normal_stop notification.  */
diff --git a/gdb/tui/tui-stack.c b/gdb/tui/tui-stack.c
index 6af674eb8b..d11649e6da 100644
--- a/gdb/tui/tui-stack.c
+++ b/gdb/tui/tui-stack.c
@@ -44,9 +44,6 @@
    Returns a pointer to a static area holding the result.  */
 static char *tui_get_function_from_frame (struct frame_info *fi);
 
-/* Set the full_name portion of the locator.  */
-static void tui_set_locator_fullname (const char *fullname);
-
 /* Update the locator, with the provided arguments.  */
 static int tui_set_locator_info (struct gdbarch *gdbarch,
 				 const char *fullname,
@@ -272,7 +269,7 @@ tui_show_locator_content (void)
 
 
 /* Set the filename portion of the locator.  */
-static void
+void
 tui_set_locator_fullname (const char *fullname)
 {
   struct tui_gen_win_info *locator = tui_locator_win_info_ptr ();
diff --git a/gdb/tui/tui-stack.h b/gdb/tui/tui-stack.h
index 5998853f97..7eca50d56d 100644
--- a/gdb/tui/tui-stack.h
+++ b/gdb/tui/tui-stack.h
@@ -24,6 +24,7 @@
 
 struct frame_info;
 
+extern void tui_set_locator_fullname (const char *fullname);
 extern void tui_update_locator_fullname (const char *);
 extern void tui_show_locator_content (void);
 extern int tui_show_frame_info (struct frame_info *);
-- 
2.15.1.windows.2

